{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "owbastion-com",
  // Nitro `cloudflare_module` output; rebuild with `pnpm --filter @owbastion/portal build:worker`.
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public",
    // Keep the existing slashless URLs canonical: /blog/ redirects to /blog.
    "html_handling": "drop-trailing-slash",
  },
  "workers_dev": true,
  "observability": {
    "enabled": false,
    "issues": {
      "enabled": false,
    },
  },
  "vars": {
    // Same-origin proxies forward to the API Worker; override locally via .dev.vars.
    "NUXT_PUBLIC_API_BASE_URL": "https://api.owbastion.com",
    "NUXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFbNuMEwD3uRasr9",
  },
  // Required by `wrangler preview`; Worker Previews do not inherit top-level `vars`.
  "previews": {
    "vars": {
      "NUXT_PUBLIC_API_BASE_URL": "https://api.owbastion.com",
      "NUXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFbNuMEwD3uRasr9",
    },
  },
}
