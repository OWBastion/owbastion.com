{
  "name": "@owbastion/codes",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check:portal-file-upload": "bash tools/check-portal-file-upload.sh",
    "dev:portal": "pnpm --filter @owbastion/portal dev",
    "dev:api": "pnpm exec wrangler dev --config wrangler.toml",
    "dev:api:local": "pnpm exec wrangler dev --config wrangler.local.toml",
    "dev:portal:local": "HOST=0.0.0.0 PORT=3000 NUXT_PUBLIC_API_BASE_URL=http://localhost:8787 NUXT_PUBLIC_LOCAL_DEV_AUTH=true pnpm --filter @owbastion/portal dev",
    "dev:local": "bash tools/dev-local.sh",
    "db:seed:local": "bash tools/seed-local.sh",
    "db:import:catalog": "node --experimental-strip-types tools/import-title-catalog.ts",
    "db:generate-title-migration": "node --experimental-strip-types tools/generate-title-catalog-migration.ts",
    "db:reconcile:map-title-rules": "pnpm exec wrangler d1 execute DB --local --file tools/map-title-rule-reconciliation.sql --json",
    "deploy:api-endpoints": "node --experimental-strip-types tools/deploy-api-endpoints.ts",
    "check:migrations": "bash tools/check-migrations.sh && bash tools/test-single-active-group-migration.sh && bash tools/test-global-qq-member-open-id-migration.sh && bash tools/test-title-grant-migration.sh && bash tools/test-pioneer-scope-migration.sh",
    "build:portal": "pnpm --filter @owbastion/portal build",
    "build:api": "pnpm --filter @owbastion/api build",
    "build": "pnpm --recursive --if-present run build",
    "pretest": "pnpm --filter @owbastion/portal exec nuxi prepare",
    "typecheck:portal": "pnpm --filter @owbastion/portal typecheck",
    "typecheck:api": "pnpm --filter @owbastion/api typecheck",
    "test": "vitest run && pnpm run test:portal-ui --run && pnpm run test:portal-e2e",
    "test:portal-ui": "pnpm --filter @owbastion/portal run test:ui",
    "test:portal-e2e": "pnpm --filter @owbastion/portal run test:e2e",
    "test:api": "pnpm exec vitest run apps/api",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "check": "pnpm run check:migrations && pnpm run test && pnpm run typecheck && pnpm run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260723.1",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
